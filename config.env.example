# /etc/aws-vpn-sso/config.env

# Work profile from IT (unmodified .ovpn; aws-vpn-sso strips AWS-only directives).
AWS_VPN_PROFILE=/etc/aws-vpn-sso/profile.ovpn

# Space-separated domains to resolve via work DNS (split DNS), e.g. "corp.example internal".
# Everything else keeps using normal/Tailscale DNS.
AWS_VPN_DNS_DOMAINS=

# "yes" to honour a pushed redirect-gateway (send ALL traffic via work). Default: ignore it.
AWS_VPN_ALLOW_FULL_TUNNEL=no
