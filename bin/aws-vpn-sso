#!/usr/bin/env python3
"""Headless AWS Client VPN (SAML) controller.

Serves http://127.0.0.1:35001 — the fixed ACS URL AWS Client VPN SAML apps
use. Reach it from a laptop over `ssh -L 35001:localhost:35001`.

  GET  /            disconnected: start phase 1, redirect browser to IdP
                    otherwise: status page
  POST /            IdP posts SAMLResponse here -> phase 2 (connect)
  POST /disconnect  stop the tunnel
  GET  /status      JSON state

Flow (per samm-git/aws-vpn-client):
  1. openvpn-aws with creds N/A / ACS::35001 -> server replies
     AUTH_FAILED,CRV1:<flags>:<sid>:<user>:<idp-url>
  2. Reconnect to the SAME server IP with password CRV1::<sid>::<SAMLResponse>
"""

import html
import json
import os
import re
import secrets
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
from collections import deque
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

PROFILE = os.environ.get("AWS_VPN_PROFILE", "/etc/aws-vpn-sso/profile.ovpn")
OPENVPN = os.environ.get("AWS_VPN_OPENVPN", "/usr/local/libexec/aws-vpn-sso/openvpn-aws")
DNS_UPDOWN = os.environ.get("AWS_VPN_DNS_UPDOWN", "/usr/local/libexec/aws-vpn-sso/dns-updown")
RUNTIME_DIR = os.environ.get("RUNTIME_DIRECTORY", "/run/aws-vpn-sso")
DNS_DOMAINS = os.environ.get("AWS_VPN_DNS_DOMAINS", "").split()
ALLOW_FULL_TUNNEL = os.environ.get("AWS_VPN_ALLOW_FULL_TUNNEL", "no") == "yes"
LISTEN = ("127.0.0.1", int(os.environ.get("AWS_VPN_LISTEN_PORT", "35001")))  # IdP ACS is fixed at 35001; override for tests
PHASE1_TIMEOUT = 30
SAML_TIMEOUT = 300  # how long a phase-1 session waits for the browser
CONNECT_TIMEOUT = 60

# Directives the AWS client handles itself, or that we set per phase.
STRIP = {"auth-user-pass", "auth-federate", "auth-retry", "remote",
         "remote-random-hostname", "dns-updown", "script-security"}

CRV1_RE = re.compile(r"AUTH_FAILED,CRV1:([^:]*):([^:]+):([^:]*):(https://\S+)")


def log(msg):
    print(msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- profile

def load_profile(path):
    """Return (sanitised config text, host, port, proto)."""
    text = open(path).read()
    host = port = None
    proto = "udp"
    out, in_block = [], None
    for line in text.splitlines():
        s = line.strip()
        if in_block:  # inline <ca>…</ca> etc. pass through untouched
            out.append(line)
            if s == f"</{in_block}>":
                in_block = None
            continue
        m = re.match(r"<([a-z-]+)>$", s)
        if m:
            in_block = m.group(1)
            out.append(line)
            continue
        words = s.split()
        if not words or words[0].startswith(("#", ";")):
            out.append(line)
            continue
        key = words[0]
        if key == "remote" and host is None:
            host = words[1]
            port = words[2] if len(words) > 2 else "443"
            if len(words) > 3:
                proto = words[3]
        elif key == "proto":
            proto = words[1]
        if key in STRIP or key == "proto":
            continue
        out.append(line)
    if not host:
        raise SystemExit(f"{path}: no 'remote' line")
    proto = proto.replace("-client", "")
    out += [
        "# --- added by aws-vpn-sso ---",
        "auth-retry none",
        "script-security 2",
        f"dns-updown {DNS_UPDOWN}",
        f'setenv AWS_VPN_DNS_DOMAINS "{" ".join(DNS_DOMAINS)}"',
    ]
    if not ALLOW_FULL_TUNNEL:
        # Keep Tailscale/LAN routing intact; only pushed subnets go via VPN.
        out.append('pull-filter ignore "redirect-gateway"')
    return "\n".join(out) + "\n", host, port, proto


def resolve_server(host):
    if os.environ.get("AWS_VPN_SERVER_IP"):  # override (debugging/tests)
        return os.environ["AWS_VPN_SERVER_IP"]
    # Mirror remote-random-hostname: random label in front of the endpoint name.
    name = f"{secrets.token_hex(6)}.{host}"
    for fam, *_, addr in socket.getaddrinfo(name, None, socket.AF_INET):
        return addr[0]
    raise OSError(f"cannot resolve {name}")


# ---------------------------------------------------------------- state

class VPN:
    def __init__(self):
        self.lock = threading.Lock()
        self.state = "idle"        # idle|starting|awaiting_saml|connecting|connected|failed
        self.detail = ""
        self.since = time.time()
        self.session = None        # dict(sid, url, ip, port, proto, conf, at)
        self.proc = None
        self.logs = deque(maxlen=200)

    def set(self, state, detail=""):
        self.state, self.detail, self.since = state, detail, time.time()
        log(f"state -> {state}{': ' + detail if detail else ''}")

    def snapshot(self):
        return {"state": self.state, "detail": self.detail,
                "since": int(self.since),
                "server": self.session and self.session.get("ip")}

    # -- helpers
    def _write_secret(self, name, content):
        fd, path = tempfile.mkstemp(prefix=name, dir=RUNTIME_DIR)
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(path, 0o600)
        return path

    def _cmd(self, conf, ip, port, proto, authfile):
        return [OPENVPN, "--config", conf, "--verb", "3",
                "--proto", proto, "--remote", ip, port,
                "--auth-user-pass", authfile]

    # -- phase 1
    def begin_login(self):
        """Returns IdP URL. Raises on failure."""
        with self.lock:
            if self.state in ("connecting", "connected"):
                raise RuntimeError(f"already {self.state}")
            s = self.session
            if self.state == "awaiting_saml" and time.time() - s["at"] < SAML_TIMEOUT:
                return s["url"]  # reuse pending session (page reload)
            self.set("starting")
        try:
            conf_text, host, port, proto = load_profile(PROFILE)
            ip = resolve_server(host)
            conf = os.path.join(RUNTIME_DIR, "vpn.conf")
            with open(conf, "w") as f:
                f.write(conf_text)
            auth = self._write_secret("phase1-", "N/A\nACS::35001\n")
            log(f"phase 1: {OPENVPN} -> {ip}:{port}/{proto}")
            try:
                out = subprocess.run(self._cmd(conf, ip, port, proto, auth),
                                     capture_output=True, text=True,
                                     timeout=PHASE1_TIMEOUT).stdout
            except subprocess.TimeoutExpired as e:
                out = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
            finally:
                os.unlink(auth)
            m = CRV1_RE.search(out)
            if not m:
                tail = "\n".join(out.splitlines()[-15:])
                raise RuntimeError(f"no CRV1 challenge from server:\n{tail}")
            sid, url = m.group(2), m.group(4)
            with self.lock:
                self.session = dict(sid=sid, url=url, ip=ip, port=port,
                                    proto=proto, conf=conf, at=time.time())
                self.set("awaiting_saml")
            return url
        except Exception as e:
            with self.lock:
                self.set("failed", str(e))
            raise

    # -- phase 2
    def complete_login(self, saml_response):
        with self.lock:
            if self.state != "awaiting_saml":
                raise RuntimeError(f"not expecting a SAML response (state={self.state})")
            s = self.session
            if time.time() - s["at"] > SAML_TIMEOUT:
                self.set("failed", "login session expired; start again")
                raise RuntimeError(self.detail)
            self.set("connecting")
        auth = self._write_secret("phase2-", f"N/A\nCRV1::{s['sid']}::{saml_response}\n")
        log(f"phase 2: connecting to {s['ip']}:{s['port']}/{s['proto']}")
        proc = subprocess.Popen(self._cmd(s["conf"], s["ip"], s["port"], s["proto"], auth),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, start_new_session=True)
        with self.lock:
            self.proc = proc
        threading.Thread(target=self._watch, args=(proc, auth), daemon=True).start()
        threading.Thread(target=self._connect_deadline, args=(proc,), daemon=True).start()

    def _watch(self, proc, auth):
        ended = None
        for line in proc.stdout:
            line = line.rstrip()
            self.logs.append(line)
            log(f"openvpn: {line}")
            if "server-pushed-halt" in line:
                ended = "session ended by server (max session duration); sign in again"
            elif "Initialization Sequence Completed" in line:
                with self.lock:
                    if self.proc is proc:
                        self.set("connected")
                try:
                    os.unlink(auth)  # single-use; openvpn has read it
                except FileNotFoundError:
                    pass
            elif "AUTH_FAILED" in line:
                with self.lock:
                    if self.proc is proc:
                        self.set("failed", line.split("AUTH_FAILED", 1)[1][:200] or "auth failed")
        rc = proc.wait()
        try:
            os.unlink(auth)
        except FileNotFoundError:
            pass
        with self.lock:
            if self.proc is proc:
                self.proc = None
                if self.state == "disconnecting":
                    self.set("idle")
                elif ended:
                    self.set("idle", ended)
                elif self.state != "failed":
                    self.set("failed", f"openvpn exited ({rc})")

    def _connect_deadline(self, proc):
        time.sleep(CONNECT_TIMEOUT)
        with self.lock:
            if self.proc is proc and self.state == "connecting":
                self.set("failed", "timed out connecting")
                proc.terminate()

    def disconnect(self):
        with self.lock:
            proc = self.proc
            if not proc:
                self.set("idle")
                return
            self.set("disconnecting")
        proc.terminate()
        try:
            proc.wait(10)
        except subprocess.TimeoutExpired:
            proc.kill()


vpn = VPN()


# ---------------------------------------------------------------- http

PAGE = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width">
<title>AWS VPN: {state}</title>
{refresh}
<style>body{{font:16px system-ui;max-width:40em;margin:3em auto;padding:0 1em}}
pre{{background:#eee;padding:1em;overflow:auto;font-size:12px}}</style>
<h1>AWS VPN: {state}</h1>
<p>{detail}</p>
{actions}
<details><summary>Recent log</summary><pre>{logs}</pre></details>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = "aws-vpn-sso"

    def log_message(self, fmt, *args):
        log("http: " + fmt % args)

    def _send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _page(self, code=200):
        s = vpn.snapshot()
        busy = s["state"] in ("starting", "connecting", "disconnecting")
        if s["state"] == "connected":
            actions = '<form method=post action=/disconnect><button>Disconnect</button></form>'
        elif busy:
            actions = ""
        else:
            actions = '<form method=get action=/connect><button>Connect</button></form>'
        detail = html.escape(s["detail"] or "")
        if s["server"]:
            detail += f"<br><small>server {html.escape(s['server'])}</small>"
        self._send(code, PAGE.format(
            state=html.escape(s["state"]), detail=detail, actions=actions,
            refresh='<meta http-equiv=refresh content=2>' if busy else "",
            logs=html.escape("\n".join(list(vpn.logs)[-40:]))))

    def _same_origin(self):
        origin = self.headers.get("Origin")
        return origin in (None, "null", "http://localhost:35001", "http://127.0.0.1:35001")

    def do_GET(self):
        path = urlsplit(self.path).path  # forms add "?"; ignore query strings
        if path == "/status":
            return self._send(200, json.dumps(vpn.snapshot()), "application/json")
        if path in ("/", "/connect"):
            # Not connected (or connecting): start/resume sign-in.
            if vpn.state not in ("idle", "awaiting_saml", "failed"):
                return self._page()
            try:
                url = vpn.begin_login()
            except Exception:
                return self._page(502)
            return self._send(302, "", headers=[("Location", url)])
        self._send(404, "not found", "text/plain")

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length > 1 << 20:
            return self._send(413, "too large", "text/plain")
        body = self.rfile.read(length).decode()
        path = urlsplit(self.path).path
        if path == "/":
            saml = parse_qs(body).get("SAMLResponse", [""])[0]
            if not saml:
                return self._send(400, "missing SAMLResponse", "text/plain")
            try:
                vpn.complete_login(saml)
            except Exception:
                return self._page(409)
            return self._send(303, "", headers=[("Location", "/")])
        if path == "/disconnect":
            if not self._same_origin():
                return self._send(403, "bad origin", "text/plain")
            vpn.disconnect()
            return self._send(303, "", headers=[("Location", "/")])
        self._send(404, "not found", "text/plain")


def main():
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    if len(sys.argv) > 1 and sys.argv[1] == "check-profile":
        conf, host, port, proto = load_profile(PROFILE)
        print(conf)
        print(f"# endpoint: {host} {port}/{proto}", file=sys.stderr)
        return
    srv = ThreadingHTTPServer(LISTEN, Handler)

    def stop(*_):
        vpn.disconnect()
        threading.Thread(target=srv.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log(f"listening on http://{LISTEN[0]}:{LISTEN[1]} profile={PROFILE}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
