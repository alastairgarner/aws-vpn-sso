#!/usr/bin/env bash
# Stub openvpn-aws: phase 1 -> CRV1 challenge; phase 2 -> "connected" until SIGTERM.
args="$*"; auth=""; while [ $# -gt 0 ]; do [ "$1" = --auth-user-pass ] && auth=$2; shift; done
echo "args: $args"
pass=$(sed -n 2p "$auth")
if [ "$pass" = "ACS::35001" ]; then
  echo "2026-11-25 08:00:00 AUTH: Received control message: AUTH_FAILED,CRV1:R:instance-1/1234/abcd-sid:b'Ti9B':https://idp.example/saml?SAMLRequest=xyz"
  exit 1
fi
case "$pass" in CRV1::instance-1/1234/abcd-sid::FAKE-SAML*) ;; *) echo "AUTH_FAILED bad pass: $pass"; exit 1;; esac
echo "2026-11-25 08:00:01 Initialization Sequence Completed"
trap 'echo "SIGTERM"; exit 0' TERM
[ -e "$(dirname "$auth")/halt" ] && { sleep 1; echo "SIGTERM[soft,server-pushed-halt] received, process exiting"; exit 0; }
while :; do sleep 0.2; done
